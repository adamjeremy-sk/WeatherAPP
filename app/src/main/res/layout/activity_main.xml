<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Main Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_light">

        <!-- Snowfall Easter Egg Layer -->
        <com.weatherapp.libre.SnowflakeView
            android:id="@+id/snowflakeOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Heat Mirage Shimmer Easter Egg Layer -->
        <com.weatherapp.libre.HeatShimmerView
            android:id="@+id/heatShimmerOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top App Bar / Location Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="0dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <ImageButton
                        android:id="@+id/btnMenu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Open Settings"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_menu"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/text_primary" />

                    <LinearLayout
                        android:id="@+id/layoutLocationClickable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/btnMenu"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivPin"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="Location Pin"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/brand_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLocationName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="Ottawa, Ontario ▾" />

                            <TextView
                                android:id="@+id/tvAttribution"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                tools:text="Source: Environment Canada GEM Model" />

                            <TextView
                                android:id="@+id/tvOpenMeteoAccreditation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingVertical="1dp"
                                android:text="Weather data provided by Open-Meteo.com"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Sticky Location Tabs Container (Pinned above ScrollView when Sticky Tabs = True) -->
            <FrameLayout
                android:id="@+id/layoutStickyTabsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/background_light"
                android:elevation="4dp"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <!-- Swipe Refresh Layout -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="24dp">

                        <!-- Scrollable Location Tabs Container (Scrolls away when Sticky Tabs = False) -->
                        <FrameLayout
                            android:id="@+id/layoutScrollableTabsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="8dp">

                            <!-- Location Tabs Card -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardLocationTabs"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/surface_card"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="2dp"
                                app:strokeColor="@color/divider_color"
                                app:strokeWidth="1dp">

                                <com.google.android.material.tabs.TabLayout
                                    android:id="@+id/tabLayoutLocations"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:background="@android:color/transparent"
                                    app:tabGravity="fill"
                                    app:tabIndicatorColor="@color/brand_primary"
                                    app:tabIndicatorHeight="3dp"
                                    app:tabMode="fixed"
                                    app:tabRippleColor="@android:color/transparent"
                                    app:tabSelectedTextColor="@color/brand_primary"
                                    app:tabTextColor="@color/text_secondary" />

                            </com.google.android.material.card.MaterialCardView>

                        </FrameLayout>

                        <!-- Active ECCC / CAP Weather Alert Banner Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardAlertBanner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="0dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="#2A1015"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="4dp"
                            app:strokeColor="#FF4D4D"
                            app:strokeWidth="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvAlertHeaderTitle"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textColor="#FF4D4D"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        tools:text="🚨 ECCC SEVERE WEATHER ALERT" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnDismissAlert"
                                        style="@style/Widget.Material3.Button.TextButton"
                                        android:layout_width="wrap_content"
                                        android:layout_height="36dp"
                                        android:paddingHorizontal="8dp"
                                        android:text="Dismiss"
                                        android:textColor="#FF9999"
                                        android:textSize="12sp" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvAlertHeadline"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="Tornado Warning in effect for Ottawa - Gatineau" />

                                <TextView
                                    android:id="@+id/tvAlertInstructions"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    tools:text="Take cover immediately if threatening weather approaches. Go indoors to a room on the lowest floor, away from outside walls and windows." />

                                <TextView
                                    android:id="@+id/tvAlertSource"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Source: Environment and Climate Change Canada (ECCC / CAP-CP Protocol)"
                                    android:textColor="#FFB3B3"
                                    android:textSize="11sp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Main Selected Day Weather Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardTodayDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="12dp"
                            app:cardBackgroundColor="@color/surface_card"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="3dp"
                            app:strokeColor="@color/divider_color"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <!-- Date Header Row -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvSelectedDateHeader"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textColor="@color/brand_primary"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        tools:text="TODAY • SEP 29 • 13:43" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnInlineMenu"
                                        style="@style/Widget.Material3.Button.TonalButton"
                                        android:layout_width="wrap_content"
                                        android:layout_height="40dp"
                                        android:paddingHorizontal="12dp"
                                        android:text="Weather ▾"
                                        android:textSize="13sp"
                                        app:icon="@drawable/ic_weather" />

                                </LinearLayout>

                                <!-- Hero Weather Section (Surface Card Secondary Background) -->
                                <LinearLayout
                                    android:id="@+id/layoutHeroSection"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:background="@drawable/bg_metric_card"
                                    android:orientation="vertical"
                                    android:padding="16dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <!-- Dominant Current Temp Text -->
                                        <TextView
                                            android:id="@+id/tvCurrentTemp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="@color/text_primary"
                                            android:textSize="44sp"
                                            android:textStyle="bold"
                                            tools:text="21.5°C" />

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="16dp"
                                            android:layout_weight="1"
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal">

                                            <TextView
                                                android:id="@+id/tvMainEmoji"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="36sp"
                                                tools:text="☁️" />

                                            <TextView
                                                android:id="@+id/tvMainCondition"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="10dp"
                                                android:ellipsize="end"
                                                android:maxLines="2"
                                                android:textColor="@color/text_primary"
                                                android:textSize="20sp"
                                                android:textStyle="bold"
                                                tools:text="Overcast" />

                                        </LinearLayout>

                                    </LinearLayout>

                                </LinearLayout>

                                <!-- Container 1: Default Standard Weather Details -->
                                <include layout="@layout/section_inline_subtabs" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- 7-Day Forecast Title -->
                        <TextView
                            android:id="@+id/tvForecastHeaderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="8dp"
                            android:text="7-Day Forecast"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <!-- Forecast List -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvForecast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="7"
                            tools:listitem="@layout/item_day_forecast" />

                    </LinearLayout>

                </androidx.core.widget.NestedScrollView>

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </LinearLayout>

        <!-- Centered Loading Spinner -->
        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Error Layout -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                tools:text="Failed to load weather data." />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Retry" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDismissError"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Dismiss" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer View -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="false"
        app:headerLayout="@layout/nav_header_settings"
        app:menu="@menu/menu_settings_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
