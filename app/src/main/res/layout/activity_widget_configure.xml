<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_widget_container">

    <TextView
        android:id="@+id/tv_config_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_features_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_features"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/widget_accent"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/cb_show_night_vis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_show_night_vis"
        android:textColor="@color/widget_text_primary"
        android:checked="true"
        android:layout_marginBottom="4dp" />

    <CheckBox
        android:id="@+id/cb_show_solunar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_show_solunar"
        android:textColor="@color/widget_text_primary"
        android:checked="true"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_save_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_btn_save"
        android:backgroundTint="@color/widget_pill_selected_color"
        android:textColor="#FFFFFF" />

</LinearLayout>
