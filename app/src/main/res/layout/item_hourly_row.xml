<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardHourlyRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="2dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main Summary Header Row (3 Columns) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutHourlyHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <!-- Column 1: Localized Hour Label (Left, Width 54dp) -->
            <TextView
                android:id="@+id/tvHourlyTime"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Now" />

            <!-- Column 2: Condition Vector Icon + Condition Text (Center) -->
            <LinearLayout
                android:id="@+id/layoutConditionCenter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/layoutTempPrecip"
                app:layout_constraintStart_toEndOf="@id/tvHourlyTime"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivHourlyConditionIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/ic_condition_clear_sky" />

                <TextView
                    android:id="@+id/tvHourlyConditionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="Mainly Clear" />

            </LinearLayout>

            <!-- Column 3: Temperature & Precip Probability (Right, Width 75dp) -->
            <LinearLayout
                android:id="@+id/layoutTempPrecip"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvHourlyTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="21°C" />

                <LinearLayout
                    android:id="@+id/layoutPrecip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvDroplet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💧 "
                        android:textColor="@color/brand_primary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvPrecipProb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="40%" />

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Expanded Stat Grid Panel (2 Columns, Default GONE) -->
        <LinearLayout
            android:id="@+id/layoutExpandedPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_card_secondary"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Stat Row 1: Feels Like (Left) | Wind (Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatFeelsLike"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:text="Feels like: 22°C" />

                <TextView
                    android:id="@+id/tvStatWind"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:text="Wind: 15 km/h ↗" />

            </LinearLayout>

            <!-- Stat Row 2: Humidity (Left) | Dew Point (Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatHumidity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:text="Humidity: 65%" />

                <TextView
                    android:id="@+id/tvStatDewPoint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:text="Dew point: 14°C" />

            </LinearLayout>

            <!-- Stat Row 3: Precipitation Amount (Left) | Cloud Cover (Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatPrecipAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:text="Precipitation: 0.2 mm" />

                <TextView
                    android:id="@+id/tvStatCloudCover"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:text="Cloud cover: 45%" />

            </LinearLayout>

            <!-- Stat Row 4: Visibility (Left) | UV Index (Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatVisibility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:text="Visibility: 10 km" />

                <TextView
                    android:id="@+id/tvStatUvIndex"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:text="UV index: 3.5" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
