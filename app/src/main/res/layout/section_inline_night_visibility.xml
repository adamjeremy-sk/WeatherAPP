<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutInlineNightVisibilityContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvNightVisTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Night Visibility Forecast"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Empty State Message -->
    <TextView
        android:id="@+id/tvNightVisEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_metric_card"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Night visibility data unavailable for the selected night." />

    <!-- Visibility Periods RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNightVisPeriods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:nestedScrollingEnabled="false"
        tools:itemCount="3"
        tools:listitem="@layout/item_night_visibility_period" />

</LinearLayout>
