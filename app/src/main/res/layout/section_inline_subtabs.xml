<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Container 1: Default Standard Weather Details -->
    <LinearLayout
        android:id="@+id/layoutWeatherDetailsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1: Daily High (Left) | Daily Low (Right) -->
        <LinearLayout
            android:id="@+id/cardTempRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <!-- High Temp Card -->
            <FrameLayout
                android:id="@+id/cardHighTemp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="82dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_temp_high"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <!-- Lower Layer: Large Left Icon -->
                <ImageView
                    android:id="@+id/ivHighTempIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:alpha="0.22"
                    android:contentDescription="Daily High Icon"
                    android:src="@drawable/ic_temp_high"
                    app:tint="@color/temp_high" />

                <!-- Upper Layer: Foreground Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="High"
                            android:textColor="@color/temp_high"
                            android:textSize="12sp" />

                        <ImageButton
                            android:id="@+id/btnDismissHighEffect"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Dismiss Shimmer Effect"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:visibility="gone"
                            app:tint="@color/temp_high" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDailyHigh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textColor="@color/temp_high"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="18°C" />

                </LinearLayout>

            </FrameLayout>

            <!-- Low Temp Card -->
            <FrameLayout
                android:id="@+id/cardLowTemp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="82dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_temp_low"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <!-- Lower Layer: Large Left Icon -->
                <ImageView
                    android:id="@+id/ivLowTempIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:alpha="0.22"
                    android:contentDescription="Daily Low Icon"
                    android:src="@drawable/ic_temp_low"
                    app:tint="@color/temp_low" />

                <!-- Upper Layer: Foreground Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Low"
                            android:textColor="@color/temp_low"
                            android:textSize="12sp" />

                        <ImageButton
                            android:id="@+id/btnDismissLowEffect"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Dismiss Snow Effect"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:visibility="gone"
                            app:tint="@color/temp_low" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDailyLow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textColor="@color/temp_low"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="5°C" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- Row 2: Wind Speed (Left) | Air Quality & Humidity (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Wind Speed Card -->
            <FrameLayout
                android:id="@+id/layoutMetricWind"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="82dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_card"
                android:padding="12dp">

                <!-- Lower Layer: Large Left Icon -->
                <ImageView
                    android:id="@+id/ivWindIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:alpha="0.22"
                    android:src="@drawable/ic_wind"
                    app:tint="@color/brand_primary" />

                <!-- Upper Layer: Foreground Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Wind Speed"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvWindSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="30 km/h W" />

                    <TextView
                        android:id="@+id/tvWindGusts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:text="Gusts: 45 km/h" />

                </LinearLayout>

            </FrameLayout>

            <!-- Air Quality & Humidity Card -->
            <FrameLayout
                android:id="@+id/layoutMetricAqi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="82dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_card"
                android:padding="12dp">

                <!-- Lower Layer: Large Left Icon -->
                <ImageView
                    android:id="@+id/ivAqiIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:alpha="0.22"
                    android:src="@drawable/ic_aqi"
                    app:tint="@color/brand_primary" />

                <!-- Upper Layer: Foreground Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Air Quality"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvAqi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="23 • Good" />

                    <TextView
                        android:id="@+id/tvHumidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:text="Humidity: 45%" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- Row 3: UV Index (Left) | Visibility (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- UV Index Card -->
            <FrameLayout
                android:id="@+id/layoutMetricUv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="82dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_card"
                android:padding="12dp">

                <!-- Lower Layer: Large Left Icon -->
                <ImageView
                    android:id="@+id/ivUvIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:alpha="0.22"
                    android:src="@drawable/ic_uv"
                    app:tint="@color/brand_primary" />

                <!-- Upper Layer: Foreground Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="UV Index"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvUvIndex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="2.4 • Low" />

                </LinearLayout>

            </FrameLayout>

            <!-- Visibility Card -->
            <FrameLayout
                android:id="@+id/layoutMetricVisibility"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="82dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_card"
                android:padding="12dp">

                <!-- Lower Layer: Large Left Icon -->
                <ImageView
                    android:id="@+id/ivVisIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:alpha="0.22"
                    android:src="@drawable/ic_visibility"
                    app:tint="@color/brand_primary" />

                <!-- Upper Layer: Foreground Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Visibility"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvVisibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="10.0 km" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- Row 4: Sunrise (Left) | Sunset (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Sunrise Card -->
            <FrameLayout
                android:id="@+id/layoutMetricSunrise"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="82dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_card"
                android:padding="12dp">

                <!-- Lower Layer: Large Left Icon -->
                <ImageView
                    android:id="@+id/ivSunriseIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:alpha="0.22"
                    android:contentDescription="Sunrise Icon"
                    android:src="@drawable/ic_sunrise"
                    app:tint="@color/brand_primary" />

                <!-- Upper Layer: Foreground Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Sunrise"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSunrise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="06:57" />

                    <TextView
                        android:id="@+id/tvSunriseAzimuth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:text="Rising at 92° (E)" />

                </LinearLayout>

            </FrameLayout>

            <!-- Sunset Card -->
            <FrameLayout
                android:id="@+id/layoutMetricSunset"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="82dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_card"
                android:padding="12dp">

                <!-- Lower Layer: Large Left Icon -->
                <ImageView
                    android:id="@+id/ivSunsetIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:alpha="0.22"
                    android:contentDescription="Sunset Icon"
                    android:src="@drawable/ic_sunset"
                    app:tint="@color/brand_primary" />

                <!-- Upper Layer: Foreground Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Sunset"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSunset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="18:46" />

                    <TextView
                        android:id="@+id/tvSunsetAzimuth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:text="Setting at 266° (W)" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- Row 5: Total Daylight (Left) | Moon Phase & Cycle (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Total Daylight Card -->
            <FrameLayout
                android:id="@+id/layoutMetricDaylight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="82dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_card"
                android:padding="12dp">

                <!-- Lower Layer: Large Left Icon -->
                <ImageView
                    android:id="@+id/ivDaylightIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:alpha="0.22"
                    android:contentDescription="Daylight Icon"
                    android:src="@drawable/ic_daylight"
                    app:tint="@color/brand_primary" />

                <!-- Upper Layer: Foreground Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Total Daylight"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTotalDaylight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="11h 49m" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center"
                        android:text="Sunlight duration"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

            </FrameLayout>

            <!-- Moon Phase & Cycle Card -->
            <FrameLayout
                android:id="@+id/layoutMetricMoon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="82dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <!-- Lower Layer: Large Left Icon -->
                <ImageView
                    android:id="@+id/ivMoonIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:alpha="0.22"
                    android:contentDescription="Moon Icon"
                    android:src="@drawable/ic_moon"
                    app:tint="@color/brand_primary" />

                <!-- Upper Layer: Foreground Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Moon Phase &amp; Cycle"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMoonPhase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Waning Gibbous" />

                    <TextView
                        android:id="@+id/tvMoonCyclePercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:text="77% illuminated" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Container 2: Inline Hourly Forecast View -->
    <LinearLayout
        android:id="@+id/layoutInlineHourlyContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvInlineHourly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="10" />

    </LinearLayout>

    <!-- Container 3: Inline Golden Hour View -->
    <LinearLayout
        android:id="@+id/layoutInlineGoldenHourContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnInlinePrevDay"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous Day"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:id="@+id/layoutInlineDateClickable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvInlineSelectedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="TODAY • THU, SEP 24, 2026" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Calendar"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/brand_primary" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnInlineNextDay"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next Day"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/text_primary" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvInlineSolarPhases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="15"
            tools:listitem="@layout/item_solar_phase" />

    </LinearLayout>

</merge>
