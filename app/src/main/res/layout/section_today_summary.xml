<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
                                <!-- Date Header Row -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvSelectedDateHeader"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textColor="@color/brand_primary"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        tools:text="TODAY • SEP 29 • 13:43" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnInlineMenu"
                                        style="@style/Widget.Material3.Button.TonalButton"
                                        android:layout_width="wrap_content"
                                        android:layout_height="40dp"
                                        android:paddingHorizontal="12dp"
                                        android:text="Weather ▾"
                                        android:textSize="13sp"
                                        app:icon="@drawable/ic_weather" />

                                </LinearLayout>


                                <LinearLayout
                                    android:id="@+id/layoutHeroSection"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:background="@drawable/bg_metric_card"
                                    android:orientation="vertical"
                                    android:padding="16dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <!-- Dominant Current Temp Text -->
                                        <TextView
                                            android:id="@+id/tvCurrentTemp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="@color/text_primary"
                                            android:textSize="44sp"
                                            android:textStyle="bold"
                                            tools:text="21.5°C" />

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="16dp"
                                            android:layout_weight="1"
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal">

                                            <ImageView
                                                android:id="@+id/ivMainConditionIcon"
                                                android:layout_width="36dp"
                                                android:layout_height="36dp"
                                                android:importantForAccessibility="no"
                                                tools:src="@drawable/ic_condition_overcast" />

                                            <TextView
                                                android:id="@+id/tvMainCondition"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="10dp"
                                                android:ellipsize="end"
                                                android:maxLines="2"
                                                android:textColor="@color/text_primary"
                                                android:textSize="20sp"
                                                android:textStyle="bold"
                                                tools:text="Overcast" />

                                        </LinearLayout>

                                    </LinearLayout>

                                </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/cardTempRange"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <LinearLayout
                                            android:id="@+id/cardHighTemp"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_margin="3dp"
                                            android:layout_weight="1"
                                            android:background="@drawable/bg_temp_high"
                                            android:clickable="true"
                                            android:focusable="true"
                                            android:gravity="center"
                                            android:orientation="vertical"
                                            android:padding="14dp">

                                            <LinearLayout
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:gravity="center"
                                                android:orientation="horizontal">

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:gravity="center"
                                                    android:text="Daily High"
                                                    android:textColor="@color/temp_high"
                                                    android:textSize="12sp" />

                                                <ImageButton
                                                    android:id="@+id/btnDismissHighEffect"
                                                    android:layout_width="20dp"
                                                    android:layout_height="20dp"
                                                    android:layout_marginStart="4dp"
                                                    android:background="?attr/selectableItemBackgroundBorderless"
                                                    android:contentDescription="Dismiss Shimmer Effect"
                                                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                                                    android:visibility="gone"
                                                    app:tint="@color/temp_high" />

                                            </LinearLayout>

                                            <TextView
                                                android:id="@+id/tvDailyHigh"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="2dp"
                                                android:gravity="center"
                                                android:textColor="@color/temp_high"
                                                android:textSize="22sp"
                                                android:textStyle="bold"
                                                tools:text="18°C" />

                                        </LinearLayout>

                                        <LinearLayout
                                            android:id="@+id/cardLowTemp"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_margin="3dp"
                                            android:layout_weight="1"
                                            android:background="@drawable/bg_temp_low"
                                            android:clickable="true"
                                            android:focusable="true"
                                            android:gravity="center"
                                            android:orientation="vertical"
                                            android:padding="14dp">

                                            <LinearLayout
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:gravity="center"
                                                android:orientation="horizontal">

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:gravity="center"
                                                    android:text="Daily Low"
                                                    android:textColor="@color/temp_low"
                                                    android:textSize="12sp" />

                                                <ImageButton
                                                    android:id="@+id/btnDismissLowEffect"
                                                    android:layout_width="20dp"
                                                    android:layout_height="20dp"
                                                    android:layout_marginStart="4dp"
                                                    android:background="?attr/selectableItemBackgroundBorderless"
                                                    android:contentDescription="Dismiss Snow Effect"
                                                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                                                    android:visibility="gone"
                                                    app:tint="@color/temp_low" />

                                            </LinearLayout>

                                            <TextView
                                                android:id="@+id/tvDailyLow"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="2dp"
                                                android:gravity="center"
                                                android:textColor="@color/temp_low"
                                                android:textSize="22sp"
                                                android:textStyle="bold"
                                                tools:text="5°C" />

                                        </LinearLayout>

                                    </LinearLayout>

</merge>
