<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardDayCell"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:layout_margin="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#1E293B">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="4dp">

        <!-- Top Header: Day Number (Left) and Score Dot (Right) -->
        <TextView
            android:id="@+id/tvDayNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="14" />

        <View
            android:id="@+id/viewScoreDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_circle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Center: Moon Phase Icon -->
        <ImageView
            android:id="@+id/ivMoonPhase"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_moon_full"
            app:layout_constraintBottom_toTopOf="@+id/tvIllumination"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDayNumber" />

        <!-- Badges Container (Overlaid on top of phase icon) -->
        <LinearLayout
            android:id="@+id/layoutBadges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivMoonPhase">

            <TextView
                android:id="@+id/tvBadgeBlood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:background="@android:color/transparent"
                android:paddingHorizontal="2dp"
                android:paddingVertical="1dp"
                android:text="🔴"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvBadgeSuper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#0284C7"
                android:paddingHorizontal="2dp"
                android:paddingVertical="1dp"
                android:text="⭐"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Bottom: Illumination Percentage -->
        <TextView
            android:id="@+id/tvIllumination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#475569"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="100%" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
