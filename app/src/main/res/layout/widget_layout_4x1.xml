<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/bg_widget_container">

    <!-- Tab Bar: 4 Location Tabs -->
    <LinearLayout
        android:id="@+id/layout_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/btn_widget_tab_0"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_widget_pill_selected"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Tab 1"
            android:textColor="@color/widget_text_primary"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_widget_tab_1"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_widget_pill_unselected"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Tab 2"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/btn_widget_tab_2"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_widget_pill_unselected"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Tab 3"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/btn_widget_tab_3"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_pill_unselected"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Tab 4"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Main Widget Body (Clickable Deep-Link Area) -->
    <LinearLayout
        android:id="@+id/widget_main_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_widget_condition_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_condition_partly_cloudy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_widget_location_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Edmonton"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Partly Cloudy"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_widget_natural_light_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_widget_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18°C"
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_widget_high_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H:22° L:12°"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_widget_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_widget_sunset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_widget_moon_phase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌔 78%"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
