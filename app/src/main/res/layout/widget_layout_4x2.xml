<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ImageView
        android:id="@+id/iv_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_widget_container"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Tab Bar: 4 Location Tabs -->
        <LinearLayout
            android:id="@+id/layout_tab_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <FrameLayout
                android:id="@+id/btn_widget_tab_0"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:id="@+id/iv_pill_bg_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_widget_pill_selected"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/tv_pill_text_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Tab 1"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_widget_tab_1"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:id="@+id/iv_pill_bg_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_widget_pill_unselected"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/tv_pill_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Tab 2"
                    android:textColor="#000000"
                    android:textSize="11sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_widget_tab_2"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:id="@+id/iv_pill_bg_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_widget_pill_unselected"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/tv_pill_text_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Tab 3"
                    android:textColor="#000000"
                    android:textSize="11sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_widget_tab_3"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/iv_pill_bg_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_widget_pill_unselected"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/tv_pill_text_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Tab 4"
                    android:textColor="#000000"
                    android:textSize="11sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Main Widget Body (Clickable Deep-Link Area) -->
        <LinearLayout
            android:id="@+id/widget_main_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Equal-Thirds Content Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="0dp">

                <!-- Left Region: Icon + Arrow Sun Times, Condition, High/Low (weight = 1) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Condition Icon -->
                    <ImageView
                        android:id="@+id/iv_widget_condition_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_condition_partly_cloudy" />

                    <!-- Left Vertical Column: Arrow Sun Times, Condition, High/Low -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Abbreviated Arrow Sun Times Row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_widget_sunrise"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#000000"
                                android:textSize="10sp"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/tv_widget_sunset"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#000000"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_widget_condition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Partly Cloudy"
                            android:textColor="#000000"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_widget_high_low"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="H: 22° / L: 12°"
                            android:textColor="#000000"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Middle Region: Temp (weight = 1) -->
                <TextView
                    android:id="@+id/tv_widget_temp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="18°C"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="24sp"
                    android:autoSizeMaxTextSize="54sp"
                    android:autoSizeStepGranularity="1sp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <!-- Right Region: Moonrise, Moonset, Natural Light & Moon Phase (weight = 1) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/tv_widget_moonrise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#000000"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_widget_moonset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#000000"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical"
                        android:layout_gravity="end">

                        <TextView
                            android:id="@+id/tv_widget_natural_light_period"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#000000"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tv_widget_moon_phase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="🌔 78%"
                            android:textColor="#000000"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Lunar Timings Row (Transit, Nadir) -->
            <TextView
                android:id="@+id/tv_widget_lunar_timings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#000000"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />

            <!-- Toggleable Feature Sections -->
            <FrameLayout
                android:id="@+id/frame_widget_features"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:id="@+id/iv_feature_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_widget_feature_box"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:id="@+id/layout_widget_features"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tv_widget_night_vis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Night Visibility: Excellent"
                        android:textColor="#000000"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_widget_solunar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Solunar Activity: High"
                        android:textColor="#000000"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tv_widget_dark_sky_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#000000"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>