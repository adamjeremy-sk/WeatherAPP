    <string name="source_eccc_title">Environnement Canada (SMC / ECCC)</string>
    <string name="source_eccc_desc">Fournit les modèles numériques de prévision météorologique GEM (Global Environmental Multiscale), les flux d\'avertissements de météo violente CAP-CP du SMC et les superpositions de radar canadien en vertu de la Licence du gouvernement ouvert - Canada.</string>
    <string name="source_open_meteo_title">API météo et géocodage Open-Meteo</string>
    <string name="source_open_meteo_desc">API météo open source fournissant une intégration de modèles à haute résolution, l\'indice de qualité de l\'air (AQI) et des services de géocodage sous la licence Attribution 4.0 International (CC BY 4.0).</string>
    <string name="source_noaa_title">NOAA / National Weather Service</string>
    <string name="source_noaa_desc">Fournit les modèles de prévision mondiaux GFS et GEFS, ainsi que les algorithmes d\'élévation solaire astronomique de la NOAA dans le domaine public.</string>
    <string name="source_ai_title">Modèles d\'IA générative (Qwen, Gemini et Mistral)</string>
    <string name="source_ai_desc">Analyse par IA générative fournie par Alibaba Cloud Qwen 2.5 72B, Google Gemini 1.5 Flash et Mistral NeMo pour la synthèse de prévisions en langage naturel.</string>
    <string name="source_android_libraries_title">Bibliothèques open source Android</string>
    <string name="source_android_libraries_desc">Construit à l\'aide d\'Android Jetpack, Google Material Design 3, Kotlin Coroutines, Square OkHttp et des bibliothèques AndroidX sous licence Apache 2.0.</string>
