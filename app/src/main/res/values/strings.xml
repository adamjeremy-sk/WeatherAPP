    <string name="title_licenses_data_sources">Licenses &amp; Data Sources</string>
    <string name="desc_licenses_data_sources">Data providers, open-source libraries, and APIs utilized by this application:</string>
    <string name="source_eccc_title">Environment Canada (MSC / ECCC)</string>
    <string name="source_eccc_desc">Provides GEM (Global Environmental Multiscale) numerical weather forecast models, MSC CAP-CP severe weather warning feeds, and Canadian radar overlays under the Open Government Licence - Canada.</string>
    <string name="source_open_meteo_title">Open-Meteo Weather &amp; Geocoding API</string>
    <string name="source_open_meteo_desc">Open-source weather API providing high-resolution model integration, Air Quality Index (AQI), and geocoding services under the Attribution 4.0 International (CC BY 4.0) license.</string>
    <string name="source_noaa_title">NOAA / National Weather Service</string>
    <string name="source_noaa_desc">Provides GFS and GEFS global forecast models, as well as NOAA astronomical solar elevation algorithms in the public domain.</string>
    <string name="source_ai_title">Generative AI Models (Qwen, Gemini &amp; Mistral)</string>
    <string name="source_ai_desc">Generative AI analysis provided by Alibaba Cloud Qwen 2.5 72B, Google Gemini 1.5 Flash, and Mistral NeMo for natural language forecast synthesis.</string>
    <string name="source_android_libraries_title">Android Open Source Libraries</string>
    <string name="source_android_libraries_desc">Built using Android Jetpack, Google Material Design 3, Kotlin Coroutines, Square OkHttp, and AndroidX libraries licensed under the Apache 2.0 License.</string>

