    <string name="title_cache_settings">Data Cache Settings</string>
    <string name="desc_cache_settings">Configure in-memory forecast caching and API query optimization.</string>
    <string name="title_enable_cache_ttl">Enable Forecast Data Cache (TTL)</string>
    <string name="desc_enable_cache_ttl">Reuses recent forecast data when switching back to previously viewed cities.</string>
    <string name="title_cache_ttl_duration">Cache TTL Duration (Time-To-Live)</string>
    <string name="title_why_ttl_caching">Why TTL Caching is Used</string>
    <string name="desc_why_ttl_caching">Time-To-Live (TTL) caching temporarily preserves weather responses in memory. When you switch between city tabs, cached data loads instantly without sending redundant network queries to weather servers.</string>
    <string name="title_api_rate_limiting_warning">⚠️ API Rate Limiting &amp; 503 Warning</string>
    <string name="desc_api_rate_limiting_warning">Disabling the cache or setting a very short TTL duration causes fresh network requests on every city switch. Frequent rapid switching may trigger HTTP 503 rate-limit errors from weather providers.</string>

